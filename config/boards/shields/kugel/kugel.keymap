#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/trackball.h>

#define DEFAULT 0
#define LOWER   1
#define RAISE   2
#define ADJUST  3
#define MOUSE   4
#define SNIPE   5
#define LAYER_6 6
#define LAYER_7 7

/ {
	keymap {
		compatible = "zmk,keymap";

		default_layer {
			display-name = "Default";
			bindings = <
				&mt LGUI ESC   &kp Q    &kp W    &kp E     &kp R     &kp T            &kp Y     &kp U     &kp I     &kp O     &kp P     &kp MINUS &kp BSPC
				&mt LCTRL TAB &kp A    &kp S    &kp D     &kp F     &kp G            &kp H     &kp J     &kp K     &kp L     &kp SEMI  &kp RET
				&kp LSHFT &kp Z    &kp X    &kp C     &kp V     &kp B            &kp N     &kp M     &kp COMMA &kp DOT   &kp FSLH
				                   &kp LALT &mo LOWER &mt LSHIFT SPACE                            &mkp LCLK &mkp RCLK &mo RAISE &kp LGUI
			>;
		};

		lower_layer {
			display-name = "Lower";
			bindings = <
				&kp ESC   &kp N1   &kp N2   &lt SNIPE N3    &kp N4    &kp N5           &kp N6    &kp N7    &kp N8    &kp N9    &kp N0    &kp EQUAL &kp DEL
				&trans    &kp EXCL &kp AT   &kp HASH  &kp DLLR  &kp PRCNT        &kp CARET &kp AMPS  &kp STAR  &kp LPAR  &kp RPAR  &kp SQT
				&trans    &kp PLUS &kp MINUS &kp ASTRK &kp SLASH &kp EQUAL       &kp LBKT  &kp RBKT  &kp LBRC  &kp RBRC  &kp BSLH
				                   &trans   &trans    &trans                               &mkp MCLK &trans    &mo ADJUST &trans
			>;
		};

		raise_layer {
			display-name = "Raise";
			bindings = <
				&kp GRAVE &kp F1   &kp F2   &kp F3    &kp F4    &kp F5           &kp F6    &kp F7    &kp F8    &kp F9    &kp F10   &kp F11   &kp F12
				&trans    &none    &none    &none     &none     &none            &kp LEFT  &kp DOWN  &kp UP    &kp RIGHT &kp HOME  &kp PG_UP
				&trans    &none    &none    &none     &none     &none            &none     &none     &none     &kp END   &kp PG_DN
				                   &trans   &mo ADJUST &trans                              &trans    &trans    &trans    &trans
			>;
		};

		adjust_layer {
			display-name = "Adjust";
			bindings = <
				&bootloader &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3 &bt BT_CLR      &out OUT_USB &out OUT_BLE &out OUT_TOG &none &none &none &bootloader
				&none       &tb TB_AM_TOG &tb TB_SCRL_TOG &none    &none        &none            &kp C_PREV   &kp C_VOL_DN &kp C_VOL_UP &kp C_NEXT &kp C_PP &none
				&none       &tb TB_SPD_DN &tb TB_SPD_UP   &none    &none        &none            &none        &none        &none        &none      &none
				                         &trans       &trans       &trans                                     &mkp MB4     &mkp MB5     &trans     &trans
			>;
		};

		mouse_layer {
			display-name = "Mouse";
			bindings = <
				&trans    &trans       &trans          &trans       &trans       &trans           &trans    &trans    &trans    &trans    &trans    &trans    &trans
				&trans    &mkp MB4     &mkp MB5        &mkp MCLK    &mo SNIPE    &tb TB_SCRL_TOG  &trans    &trans    &trans    &trans    &trans    &trans
				&trans    &trans       &trans          &trans       &trans       &trans           &trans    &trans    &trans    &trans    &trans
				                       &trans          &trans       &trans                                  &mkp LCLK &mkp RCLK &mo RAISE &kp LGUI
			>;
		};

		snipe_layer {
			display-name = "Snipe";
			bindings = <
				&trans    &trans       &trans          &trans       &trans       &trans           &trans    &trans    &trans    &trans    &trans    &trans    &trans
				&trans    &trans       &trans          &trans       &trans       &trans           &trans    &trans    &trans    &trans    &trans    &trans
				&trans    &trans       &trans          &trans       &trans       &trans           &trans    &trans    &trans    &trans    &trans
				                       &trans          &trans       &trans                                  &mkp LCLK &mkp RCLK &trans    &trans
			>;
		};

		layer_6 {
			display-name = "Layer 6";
			bindings = <
				&trans &trans &trans &trans &trans &trans        &trans &trans &trans &trans &trans &trans &trans
				&trans &trans &trans &trans &trans &trans        &trans &trans &trans &trans &trans &trans
				&trans &trans &trans &trans &trans &trans        &trans &trans &trans &trans &trans
				              &trans &trans &trans                      &trans &trans &trans &trans
			>;
		};

		layer_7 {
			display-name = "Layer 7";
			bindings = <
				&trans &trans &trans &trans &trans &trans        &trans &trans &trans &trans &trans &trans &trans
				&trans &trans &trans &trans &trans &trans        &trans &trans &trans &trans &trans &trans
				&trans &trans &trans &trans &trans &trans        &trans &trans &trans &trans &trans
				              &trans &trans &trans                      &trans &trans &trans &trans
			>;
		};
	};
};
